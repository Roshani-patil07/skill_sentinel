# ==============================================================================
# SKILL-SENTINEL: Environment Configuration Template
# Problem Statement 26245 - Smart India Hackathon (SIH) 2026
# "From Periodic Inspection to Continuous Compliance Intelligence"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=SKILL-SENTINEL
# Options: development | testing | production
APP_ENV=development
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Development / Local fallback (SQLite):
DATABASE_URL=sqlite:///./skill_sentinel.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql://sentinel_user:sentinel_secure_pass@db:5432/skill_sentinel_db

# ------------------------------------------------------------------------------
# 3. REDIS & CACHING
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Production:
# REDIS_URL=redis://:redis_password@redis:6379/0

# ------------------------------------------------------------------------------
# 4. CORS & DOMAINS
# Comma-separated allowed origins (no spaces around commas recommended)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. AI ENGINE & INFERENCE MODE
# ------------------------------------------------------------------------------
# Options: 'simulation' (zero-GPU fallback with realistic edge telemetry)
#          'inference'  (YOLOv8 / OpenCV live model inference)
AI_MODE=simulation
# Fallback to synthetic streams if RTSP / USB camera is offline
CAMERA_FALLBACK_SIMULATION=true
# AI Device fallback: 'cpu' | 'cuda' (auto-falls back to cpu if cuda unavailable)
AI_DEVICE=cpu

# ------------------------------------------------------------------------------
# 6. WHATSAPP & COMMUNICATIONS GATEWAY
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=true
# Options: 'MOCK_GATEWAY' (for demo/offline) | 'META_CLOUD_API' | 'TWILIO'
WHATSAPP_PROVIDER=MOCK_GATEWAY
WHATSAPP_API_TOKEN=mock_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=mock_phone_id

# ------------------------------------------------------------------------------
# 7. FRONTEND ENVIRONMENT (VITE)
# (Used in frontend/.env.production or during frontend build)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001/api/v1/ws
